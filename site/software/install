#!/bin/sh
# Pepper installer — https://pepper.software
# Installs @pepperchan/pepper globally via npm. AGPL-3.0.
set -e

if ! command -v node >/dev/null 2>&1; then
  echo "Pepper needs Node.js 18.17+."
  echo "Get it from https://nodejs.org — or on a Mac: brew install node"
  exit 1
fi

major=$(node -e 'console.log(process.versions.node.split(".")[0])')
if [ "$major" -lt 18 ]; then
  echo "Your Node.js is v$(node -v | tr -d v) — Pepper needs 18.17 or newer."
  exit 1
fi

echo "Installing @pepperchan/pepper…"
if ! npm install -g @pepperchan/pepper; then
  echo ""
  echo "npm could not install globally — on a system-wide Node that is usually EACCES."
  echo "Fix npm's global prefix (https://docs.npmjs.com/resolving-eacces-permissions-errors-when-installing-packages-globally)"
  echo "or run:  sudo npm install -g @pepperchan/pepper"
  exit 1
fi

echo ""
echo "🌶 Pepper is in — $(pepper version 2>/dev/null || echo 'open a new terminal for the pepper command'). Put her on the desk:"
echo ""
echo "    pepper start"
echo ""
echo "Her studio opens at http://localhost:4747 — she'll introduce herself"
echo "and ask what you care about. Plain words are fine."
